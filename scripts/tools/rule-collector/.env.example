# Prism 规则收集器配置示例
# 复制此文件为 .env 并根据需要修改配置

# 缓存目录（默认: /tmp/prism_rule_collector）
# RULE_CACHE_DIR=/tmp/prism_rule_collector

# 输出目录（默认: ./output）
# RULE_OUTPUT_DIR=./output

# 缓存天数（默认: 1）
# 超过此天数的缓存将被重新下载
# RULE_CACHE_DAYS=1

# HTTP 代理地址
# 支持 http:// 和 socks5:// 协议
# 示例：
# RULE_PROXY=http://127.0.0.1:7890
# RULE_PROXY=socks5://127.0.0.1:1080
# 或使用通用代理环境变量：
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:1080
