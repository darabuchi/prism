# Prism GeoIP 配置文件示例
# 复制此文件为 .env 并根据需要修改配置

# GeoIP 缓存目录
# 用于存储下载的原始数据文件
# 默认值: /tmp/prism_geoip
GEOIP_CACHE_DIR=/tmp/prism_geoip

# GeoIP 数据目录
# 用于存储生成的 geoip.mmdb 数据库文件
# 默认值: ./resource/geoip
GEOIP_DATA_DIR=./resource/geoip

# 缓存有效期（天）
# 在此期间内不会重新下载数据源
# 默认值: 7
GEOIP_CACHE_DAYS=7

# HTTP 代理设置（可选）
# 用于下载数据源时使用代理
# 格式: http://proxy.example.com:8080
# 或: socks5://proxy.example.com:1080
# 默认值: 空（不使用代理）
# GEOIP_PROXY=

# 或者使用标准的代理环境变量（优先级低于 GEOIP_PROXY）
# HTTP_PROXY=http://proxy.example.com:8080
# ALL_PROXY=socks5://proxy.example.com:1080

# IPInfo API Token（免费版）
# 从 https://ipinfo.io/ 获取免费 token
IPINFO_TOKEN=2900997defb845e78eae3b458b3b9823

# ============================================================
# 规则收集器配置
# ============================================================

# 规则缓存目录
# 用于存储下载的规则文件
# 默认值: /tmp/prism_rule_collector
RULE_CACHE_DIR=/tmp/prism_rule_collector

# 规则输出目录
# 用于存储生成的规则文件
# 默认值: ./resource/rules
RULE_OUTPUT_DIR=./resource/rules

# 规则缓存有效期（天）
# 在此期间内不会重新下载规则
# 默认值: 1
RULE_CACHE_DAYS=1

# HTTP 代理设置（可选）
# 用于下载规则时使用代理
# 优先使用 RULE_PROXY，其次使用 HTTP_PROXY 或 ALL_PROXY
# RULE_PROXY=http://proxy.example.com:8080
# RULE_PROXY=socks5://proxy.example.com:1080
